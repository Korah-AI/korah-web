      "id": "calc-ab-bank-u3-001",
      "status": "draft",
      "unit": "unit-3",
      "unitLabel": "Composite, Implicit, and Inverse Functions",
      "topic": "Chain rule",
      "skills": ["procedural"],
      "difficulty": "medium",
      "calculator": "prohibited",
      "stem": "If \\(h(x)=\\sin(x^2)\\), which expression is equal to \\(h'(x)\\)?",
      "choices": [
        { "key": "A", "text": "\\(2x\\cos(x^2)\\)" },
        { "key": "B", "text": "\\(2x\\sin(x^2)\\)" },
        { "key": "C", "text": "\\(\\cos(2x)\\)" },
        { "key": "D", "text": "\\(x^2\\cos(x^2)\\)" }
      ],
      "answer": "A",
      "explanation": "Apply the chain rule. The derivative of \\(\\sin(u)\\) is \\(\\cos(u)\\), and the derivative of \\(u=x^2\\) is \\(2x\\).",
      "source": {
