      "id": "calc-ab-bank-u1-001",
      "status": "draft",
      "unit": "unit-1",
      "unitLabel": "Limits and Continuity",
      "topic": "Evaluating limits",
      "skills": ["procedural"],
      "difficulty": "easy",
      "calculator": "prohibited",
      "stem": "For \\(x \\ne 3\\), let \\(f(x)=\\frac{x^2-9}{x-3}\\). What is \\(\\lim_{x\\to 3} f(x)\\)?",
      "choices": [
        { "key": "A", "text": "\\(0\\)" },
        { "key": "B", "text": "\\(3\\)" },
        { "key": "C", "text": "\\(6\\)" },
        { "key": "D", "text": "The limit does not exist." }
      ],
      "answer": "C",
      "explanation": "Factor the numerator as \\((x-3)(x+3)\\). For \\(x\\ne 3\\), the expression equals \\(x+3\\), so the limit is \\(6\\).",
