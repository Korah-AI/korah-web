{
  "version": 11,
  "randomSeed": "a29ae9b66a0f8e3c5e058ae54b1a8d3e",
  "expressions": {
    "list": [
      {
        "type": "text",
        "id": "48",
        "text": "The system of equations is graphed below, and its solution is the point (x, y). Find the value of 9x plus 5y."
      },
      {
        "type": "text",
        "id": "53",
        "text": "Set the two equations equal to each other after moving everything to one side."
      },
      {
        "type": "expression",
        "id": "90",
        "hidden": true,
        "latex": "3\\left(9x\\right)+2\\left(5y\\right)-27=-3\\left(9x\\right)+2\\left(5y\\right)-9"
      },
      {
        "type": "text",
        "id": "91",
        "text": "Solving gives the point of intersection:"
      },
      {
        "type": "expression",
        "id": "92",
        "hidden": true,
        "latex": "\\left(\\frac{1}{3},\\frac{9}{5}\\right)"
      },
      {
        "type": "text",
        "id": "93",
        "text": "Both lines are graphed, and their crossing gives x and y."
      },
      {
        "type": "expression",
        "id": "54",
        "color": "#c74440",
        "latex": "3\\left(9x\\right)+2\\left(5y\\right)=27"
      },
      {
        "type": "expression",
        "id": "55",
        "color": "#2d70b3",
        "latex": "-3\\left(9x\\right)+2\\left(5y\\right)=9"
      },
      {
        "type": "text",
        "id": "94",
        "text": "Substitute that point into the target expression:"
      },
      {
        "type": "expression",
        "id": "95",
        "hidden": true,
        "latex": "9\\cdot\\frac{1}{3}+5\\cdot\\frac{9}{5}"
      }
    ]
  }
}
