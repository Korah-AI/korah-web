{
  "version": 11,
  "randomSeed": "3f6a1c9e5b2d4a8f7c0e1b9d2a6f4c83",
  "expressions": {
    "list": [
      {
        "type": "text",
        "id": "problem_statement",
        "text": "The function f is graphed. Find a value of k for which the horizontal line at k meets the graph at three points. Choices: A is 2, B is 0, C is -2, D is -3."
      },
      {
        "type": "expression",
        "id": "main_graph",
        "color": "#2d70b3",
        "latex": "f\\left(x\\right)=x^{3}-x^{2}-x-\\frac{11}{4}"
      },
      {
        "type": "expression",
        "id": "reference_graph",
        "color": "#c74440",
        "latex": "y=-3"
      },
      {
        "type": "text",
        "id": "algebra_step_1_text",
        "text": "The turning points come from setting the derivative to zero."
      },
      {
        "type": "expression",
        "id": "algebra_step_1",
        "hidden": true,
        "latex": "3x^{2}-2x-1=0"
      },
      {
        "type": "text",
        "id": "algebra_step_2_text",
        "text": "Factoring gives the two critical points."
      },
      {
        "type": "expression",
        "id": "algebra_step_2",
        "hidden": true,
        "latex": "\\left(3x+1\\right)\\left(x-1\\right)=0"
      },
      {
        "type": "text",
        "id": "key_points_text",
        "text": "The local maximum and local minimum are marked on the curve."
      },
      {
        "type": "expression",
        "id": "key_point_1",
        "color": "#388c46",
        "showLabel": true,
        "latex": "\\left(-\\frac{1}{3},f\\left(-\\frac{1}{3}\\right)\\right)"
      },
      {
        "type": "expression",
        "id": "key_point_2",
        "color": "#6042a6",
        "showLabel": true,
        "latex": "\\left(1,f\\left(1\\right)\\right)"
      },
      {
        "type": "text",
        "id": "conclusion",
        "text": "The line crosses the curve three times only when k lies strictly between the two turning point heights, and the line shown is the choice that does."
      }
    ]
  }
}
