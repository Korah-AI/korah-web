  "expressions": {
    "list": [
      {
        "type": "text",
        "id": "32",
        "text": "The table gives two points on a line. The y-intercept of the line has x-coordinate p minus 3 and y-coordinate c, where p and c are constants. Find c."
      },
      {
        "type": "expression",
        "id": "90",
        "hidden": true,
        "latex": "p-3"
      },
      {
        "type": "text",
        "id": "91",
        "text": "The x-coordinate of a y-intercept is zero, so p minus 3 must equal zero. Slope from the two points:"
      },
      {
        "type": "expression",
        "id": "92",
        "hidden": true,
        "latex": "\\frac{-35-25}{12-3}"
      },
      {
        "type": "text",
        "id": "93",
        "text": "Use the slope and one point to find the y-intercept:"
      },
      {
        "type": "expression",
        "id": "94",
        "hidden": true,
        "latex": "25-\\left(-\\frac{20}{3}\\right)\\cdot3"
      },
      {
        "type": "text",
        "id": "47",
        "text": "A table holds the two points, p is defined, and a linear regression gives the slope and intercept."
      },
      {
        "id": "43",
        "type": "table",
        "columns": [
          {
            "values": [
              "p",
              "p+9"
            ],
            "hidden": true,
            "id": "41",
            "color": "#388c46",
            "latex": "x_{1}"
          },
          {
            "values": [
              "25",
              "-35"
            ],
            "id": "42",
            "color": "#6042a6",
            "latex": "y_{1}"
          }
        ]
      },
      {
        "type": "expression",
        "id": "45",
        "color": "#c74440",
        "latex": "p=3"
      },
      {
        "type": "expression",
        "id": "46",
        "color": "#2d70b3",
        "latex": "y_{1}\\sim mx_{1}+b"
      },
      {
        "type": "text",
        "id": "95",
        "text": "The y-intercept of the regression is c."
      }
    ]
  }
}
